{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --config vite.widget.config.ts",
        "dev": "vite",
        "types": "tsc --noEmit",
        "build:widget": "vite build --config vite.widget.config.ts",
        "build:package": "npm --prefix packages/widget run build",
        "test": "vitest run"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.4"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@inertiajs/react": "^3.7.1",
        "@tanstack/react-virtual": "^3.14.13",
        "@tiptap/extension-mention": "^3.31.3",
        "@tiptap/extension-placeholder": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/react": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "@tiptap/suggestion": "^3.31.3",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "laravel-echo": "^2.5.0",
        "lucide-react": "^1.48.0",
        "pusher-js": "^8.6.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "ziggy-js": "^2.6.4"
    }
}
