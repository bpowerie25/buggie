{
	email {$ACME_EMAIL}
}

# The central domain and every workspace subdomain, on one wildcard certificate.
#
# Listed separately because a wildcard does not cover the apex: *.buggie.eu matches
# acme.buggie.eu but not buggie.eu itself.
{$BUGGIE_DOMAIN}, *.{$BUGGIE_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	# The widget is embedded cross-origin in customers' applications by design; the
	# application sets its own CORS headers per route, so nothing is added here.
	reverse_proxy app:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
