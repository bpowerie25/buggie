# buggie.eu — production environment.
#
# Copy to .env in the repository root. Every CHANGE ME must be replaced.
# Nothing here belongs in git: .env is ignored, and it should stay that way.

APP_NAME=Buggie
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                   # CHANGE ME — artisan key:generate --show
APP_URL=https://buggie.eu

# The central domain. Workspaces are subdomains of it, so this value and the
# wildcard certificate have to agree.
APP_DOMAIN=buggie.eu
BUGGIE_DOMAIN=buggie.eu

# Cookies must be readable on every workspace subdomain, hence the leading dot.
SESSION_DOMAIN=.buggie.eu
SESSION_SECURE_COOKIE=true

# Plans, limits, billing screens and the usage banner. The single difference between
# this and a self-hosted install.
BUGGIE_HOSTED=true
BUGGIE_OPERATORS=                          # CHANGE ME — your email, comma separated

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=buggie
DB_USERNAME=buggie
DB_PASSWORD=                               # CHANGE ME — openssl rand -base64 32

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# TLS. The certificate is a wildcard, which can only be issued over DNS-01, which is
# why this needs an API token rather than nothing at all. The token needs Zone:DNS:Edit
# on buggie.eu and nothing else.
CLOUDFLARE_API_TOKEN=                      # CHANGE ME
ACME_EMAIL=                                # CHANGE ME — where Let's Encrypt writes

# Outbound mail. Notifications, digests, invitations and password resets all stop
# working silently if this is wrong, so send yourself a test after deploying.
MAIL_MAILER=smtp
MAIL_HOST=                                 # CHANGE ME
MAIL_PORT=587
MAIL_USERNAME=                             # CHANGE ME
MAIL_PASSWORD=                             # CHANGE ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=buggie@buggie.eu
MAIL_FROM_NAME=Buggie

# Inbound mail, for filing issues by email and replying to notifications.
MAIL_INBOUND_SECRET=                       # CHANGE ME — openssl rand -hex 32

# Billing. Leave blank until there is something to sell; the billing screens handle
# a plan with no price by not offering it.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Backups off the box. An rclone remote, e.g. hetzner-storage:buggie-backups
BUGGIE_BACKUP_REMOTE=
