# Buggie, self-hosted. Copy to .env and fill in the marked values.
#
# Everything is included: no plans, no limits, no billing, no telemetry.

APP_NAME=Buggie
APP_ENV=production
APP_DEBUG=false

# Required before the first start. Generate one with:
#   docker compose -f docker-compose.selfhost.yml run --rm \
#       --entrypoint php app artisan key:generate --show
# Keep it safe and do not change it once there is data: it encrypts sessions.
APP_KEY=

# The domain Buggie is served from. Workspaces live on subdomains of it, so this
# needs a wildcard DNS record (*.buggie.example.com) and a wildcard certificate.
APP_URL=https://buggie.example.com
APP_DOMAIN=buggie.example.com

# Cookies must be shared across the workspace subdomains.
SESSION_DOMAIN=.buggie.example.com

APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=buggie
DB_USERNAME=buggie
DB_PASSWORD=change-me

REDIS_HOST=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Outgoing mail: invitations, notification digests and reporter portal links.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=buggie@example.com
MAIL_FROM_NAME=Buggie

# Optional: incoming mail, so people can file issues and reply by email.
# Needs a Mailgun inbound route pointed at https://your-domain/api/mail/inbound
MAIL_INBOUND_DOMAIN=
MAILGUN_SIGNING_KEY=

# How long to gather activity on one issue before emailing about it.
DIGEST_DELAY_MINUTES=5

# Leave false. True is the commercial hosted service and turns on plan limits.
BUGGIE_HOSTED=false

# Addresses allowed into the queue dashboard at /horizon. Empty means nobody.
BUGGIE_OPERATORS=

# Optional error reporting. Empty means nothing is sent anywhere.
SENTRY_LARAVEL_DSN=
