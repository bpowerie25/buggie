{
    "name": "@buggie/widget",
    "version": "0.1.0",
    "description": "Typed loader for the Buggie bug reporter widget — screenshots, console and network context, from one call.",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bpowerie25/buggie.git",
        "directory": "packages/widget"
    },
    "homepage": "https://buggie.eu",
    "keywords": ["bug", "bug-report", "feedback", "screenshot", "issue-tracker", "buggie"],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "README.md"],
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "typescript": "^5.6.0",
        "vite": "^6.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
